# OpenWind works fully offline and keyless with these defaults.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Offline replay uses the committed archived weather cache.
WEATHER_OFFLINE=1
# Configured Previous Runs safety margin, not a provider-verified publication delay.
NWP_LATENCY_H=8

# Display/economics assumption; model power remains normalized in [0, 1].
FARM_CAPACITY_MW=5.0
HUB_HEIGHT_M=100

# Use 1 during the presentation so the agent's SSE trace is readable.
DEMO_PACING=0
USE_ML_STUB=0

# Optional polling of the selected archived NWP cache. Enable only for a
# published issue; changing its selected input values triggers one recalculation.
# This does not download or certify a provider's live run. Keyless by default.
NWP_WATCH_ENABLED=0
NWP_WATCH_POLL_SECONDS=60
NWP_WATCH_MODE=test
NWP_WATCH_ISSUE_DATE=
NWP_WATCH_USE_LLM=0
