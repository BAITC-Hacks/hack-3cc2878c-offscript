# SAMAL works fully offline and keyless with these defaults.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Set to 0 only while Person A fetches archived Open-Meteo runs into data/cache/nwp/.
WEATHER_OFFLINE=1
NWP_LATENCY_H=8

# Display/economics assumption; model power remains normalized in [0, 1].
FARM_CAPACITY_MW=5.0
HUB_HEIGHT_M=100

# Use 1 during the presentation so the agent's SSE trace is readable.
DEMO_PACING=0
USE_ML_STUB=1
