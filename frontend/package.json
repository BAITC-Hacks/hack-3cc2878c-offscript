{
  "name": "samal-control-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-mocks": "mkdir -p public/mocks && cp ../shared/mocks/*.json public/mocks/",
    "predev": "npm run copy-mocks",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run copy-mocks",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
